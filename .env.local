# 本地测试环境变量 - 不会推送到GitHub
# Supabase 配置
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Airwallex API 配置
AIRWALLEX_CLIENT_ID=your_airwallex_client_id
AIRWALLEX_SECRET_KEY=your_airwallex_secret_key
AIRWALLEX_ACCOUNT_ID=your_airwallex_account_id

# Airwallex Webhook 配置
AIRWALLEX_WEBHOOK_SECRET=your_webhook_secret

# 网站基础配置
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 开发模式配置
NODE_ENV=development
AIRWALLEX_MOCK_MODE=true